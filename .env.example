# =============================================================
# REQUIRED — Anthropic Claude (LLM tweet generation)
# =============================================================
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional override — defaults to claude-haiku-4-5-20251001
# ANTHROPIC_MODEL=claude-sonnet-4-6

# =============================================================
# REQUIRED FOR LARK INTEGRATION (outbound review cards)
# =============================================================
# From open.larksuite.com → your Custom App → Credentials & Basic Info.
# LINK MODE: the bot only CALLS Lark to post review cards — it receives no
# callbacks, so there is no verification token, encryption key, or Card Request
# URL to configure. The card's "Post on X" buttons are plain links.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_REVIEW_CHAT_ID=

# =============================================================
# REQUIRED IN PRODUCTION — API auth
# =============================================================
# Bearer token required for all /api/* routes except /api/health (public for
# monitoring probes). Protects the dashboard's API routes — still worth setting
# even though the dashboard isn't publicly exposed on the EC2 box. Generate with:
#   openssl rand -hex 32
# Skipped automatically when NODE_ENV != 'production'.
BOT_API_TOKEN=

# =============================================================
# OPTIONAL — Legal Redline review (Probly Legal Agent integration)
# =============================================================
# Off by default. When ON, each generated draft is sent to the Legal Redline
# Bot before its Lark review card is posted, and the verdict is shown on the
# card. See LEGAL_REDLINE_INTEGRATION.md. Fail-open: if the Agent is
# unreachable, the draft still posts (card shows "review unavailable").
# LEGAL_REVIEW_ENABLED=1
#
# Mode: 'stub' (deterministic local mock — exercises the flow before the real
# API exists) or 'live' (calls LEGAL_REVIEW_URL). Defaults to 'stub' when no
# URL is set, 'live' when it is.
# LEGAL_REVIEW_MODE=stub
# LEGAL_REVIEW_URL=https://<legal-agent-host>/review   # John Tang's endpoint (TBD)
# LEGAL_REVIEW_TOKEN=                                   # bearer token (TBD)
# LEGAL_REVIEW_TIMEOUT_MS=8000

# =============================================================
# OPTIONAL — Migration gate (production safety)
# =============================================================
# By default migrations only auto-run in development. In production set
# RUN_MIGRATIONS=1 explicitly when you intentionally want to apply pending
# schema changes — typically as a one-shot job before cutting traffic.
# RUN_MIGRATIONS=1

# =============================================================
# OPTIONAL — Database path (REQUIRED in production)
# =============================================================
# Absolute path to the SQLite file. Set this in production to a location
# OUTSIDE the project tree (e.g. /var/lib/signaldesk/signaldesk.db) so
# `next build` doesn't trace the cwd-relative `data/signaldesk.db` and
# clobber the live DB on every deploy. Falls back to ./data/signaldesk.db
# when unset (fine for local dev).
# DB_PATH=/var/lib/signaldesk/signaldesk.db

# =============================================================
# OPTIONAL — URLs
# =============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKET_BASE_URL=https://yourplatform.com/markets

# =============================================================
# OPTIONAL — Source API identity / rate limits
# =============================================================
# Sent as the User-Agent when fetching official feeds such as SEC EDGAR and
# weather.gov. Use a real contact address or ops URL in production.
# SIGNALDESK_USER_AGENT=SignalDeskBot/1.0 (ops@example.com)

# Optional. Increases openFDA rate limits for recall feeds.
# OPENFDA_API_KEY=
