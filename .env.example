# =============================================================
# REQUIRED — Anthropic Claude (LLM tweet generation)
# =============================================================
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional override — defaults to claude-haiku-4-5-20251001
# ANTHROPIC_MODEL=claude-sonnet-4-6

# =============================================================
# REQUIRED FOR LARK INTEGRATION (review queue + buttons)
# =============================================================
# From open.larksuite.com → your Custom App → Credentials & Basic Info
LARK_APP_ID=
LARK_APP_SECRET=
LARK_REVIEW_CHAT_ID=

# Verification token. Found in the same Credentials & Basic Info page.
# Required for Schema 2.0 callbacks (card.action.trigger, im.message.receive_v1
# etc.) — Lark sends this token in the request body's `header.token` field
# instead of using x-lark-signature headers. Without this set, Schema 2.0
# callbacks return 500 "Server not configured (LARK_VERIFICATION_TOKEN)".
LARK_VERIFICATION_TOKEN=

# =============================================================
# REQUIRED IN PRODUCTION — API auth
# =============================================================
# Bearer token required for all /api/* routes except /api/lark/callback
# (the Lark callback has its own signature verification) and /api/health
# (public for monitoring probes). Generate with:
#   openssl rand -hex 32
# Skipped automatically when NODE_ENV != 'production'.
BOT_API_TOKEN=

# =============================================================
# OPTIONAL — Migration gate (production safety)
# =============================================================
# By default migrations only auto-run in development. In production set
# RUN_MIGRATIONS=1 explicitly when you intentionally want to apply pending
# schema changes — typically as a one-shot job before cutting traffic.
# RUN_MIGRATIONS=1

# =============================================================
# OPTIONAL — Database path (REQUIRED in production)
# =============================================================
# Absolute path to the SQLite file. Set this in production to a location
# OUTSIDE the project tree (e.g. /var/lib/signaldesk/signaldesk.db) so
# `next build` doesn't trace the cwd-relative `data/signaldesk.db` and
# clobber the live DB on every deploy. Falls back to ./data/signaldesk.db
# when unset (fine for local dev).
# DB_PATH=/var/lib/signaldesk/signaldesk.db

# =============================================================
# OPTIONAL — URLs
# =============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKET_BASE_URL=https://yourplatform.com/markets

# =============================================================
# OPTIONAL — Source API identity / rate limits
# =============================================================
# Sent as the User-Agent when fetching official feeds such as SEC EDGAR and
# weather.gov. Use a real contact address or ops URL in production.
# SIGNALDESK_USER_AGENT=SignalDeskBot/1.0 (ops@example.com)

# Optional. Increases openFDA rate limits for recall feeds.
# OPENFDA_API_KEY=

# OPTIONAL — Fresh Probly quote feed (disabled until provided by engineering)
# HTTPS endpoint returning the contract in docs/newsroom.md; scrape-only mode
# still matches markets but never claims scraped prices are live quotes.
# PROBLY_MARKET_FEED_URL=
# PROBLY_MARKET_FEED_TOKEN=

# OPTIONAL — X filtered stream (existing API access and rules required)
# Allowlist numeric author IDs; only original posts from these accounts enter.
# X_BEARER_TOKEN=
# X_NEWS_AUTHOR_IDS=

# OPTIONAL — Restrict legal-clearance attestations to Lark open IDs.
# Without this, any authenticated reviewer can record an attestation.
# The dashboard uses the shared actor "web", not individual identity.
# LEGAL_REVIEWER_IDS=ou_example

# Build/staging only: disables all scheduler and external ingestion startup.
# SIGNALDESK_DISABLE_SCHEDULER=1

# OPTIONAL — per-task models. ANTHROPIC_MODEL drafts posts; these override it.
# All calls go through src/lib/ai/anthropic.ts, so a 5.5-generation model is a
# config change: it drops `temperature` (rejected, HTTP 400) and reads text blocks
# by type (replies begin with thinking blocks). Measured 2026-09-30 on production
# sources: a Sonnet 5.5 checker caught fabricated drafts the Haiku checker passed.
# ANTHROPIC_VERIFY_MODEL=claude-sonnet-5-5   # evidence checker (legal-review gate)
# ANTHROPIC_RATING_MODEL=claude-haiku-4-5-20251001   # novelty/magnitude, aliases, topics
# ANTHROPIC_EFFORT=low                       # 5.5 models only: thinking effort
